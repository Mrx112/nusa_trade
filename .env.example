# URL publik situs, dipakai untuk sitemap, robots.txt, dan metadata Open Graph.
# Di Vercel, jika kosong, VERCEL_PROJECT_PRODUCTION_URL dipakai otomatis.
NEXT_PUBLIC_SITE_URL=https://nusatrade.vercel.app

# (Opsional) Webhook tujuan setiap permintaan penawaran (RFQ) yang masuk.
# Contoh: URL webhook Slack/Discord/Make/Zapier/n8n, atau endpoint CRM Anda.
# Payload dikirim sebagai JSON via POST. Biarkan kosong untuk menonaktifkan.
RFQ_WEBHOOK_URL=
